# Normalise line endings. These files are authored on Windows but executed on
# Linux — a shell script with CRLF endings fails with `$'\r': command not found`,
# so force LF for everything that runs on the server.
* text=auto eol=lf

*.sh      text eol=lf
*.service text eol=lf
*.timer   text eol=lf
*.conf    text eol=lf
*.py      text eol=lf

# Binary — never touch
*.parquet binary
*.png     binary
*.jpg     binary
*.ico     binary
